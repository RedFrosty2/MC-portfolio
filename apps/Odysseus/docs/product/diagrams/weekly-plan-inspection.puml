@startuml
title Odysseus - Inspect Weekly Plan

left to right direction
hide empty description

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #64748B
skinparam ArrowThickness 2
skinparam defaultFontName Arial
skinparam defaultFontSize 13

skinparam state {
    BackgroundColor #F8FAFC
    BorderColor #CBD5E1
    FontColor #0F172A
}

state "<b>ACTIVE WEEKLY PLAN</b>\n\nMonday to Sunday\nGenerated by Odysseus\nPersisted as the current plan" as Plan #DCFCE7

state "<b>ATHLETE VIEWS THE WEEK</b>\n\nPlanned sessions\nRest days\nAM / PM placement\nAvailability context\nOverall weekly structure" as Week #E8F4F4

state "<b>ATHLETE SELECTS A SESSION</b>\n\nRunning\nStrength\nHybrid / HYROX\nRest" as Select #F1F5F9

state "<b>SESSION DETAIL</b>\n\nComplete prescription\nTraining purpose\nExecution guidance\nRelevant targets" as Detail #E0F2FE

state "<b>PLANNING RATIONALE</b>\n\nHow the session supports goals\nRole within the wider week\nMeaningful departure from\nathlete preference where relevant" as Rationale #EEF2FF

state "<b>ATHLETE UNDERSTANDS THE PLAN</b>\n\nWhat to do\nWhen to do it\nHow to perform it\nWhy it was prescribed" as Understand #DCFCE7

Plan --> Week : Athlete opens plan
Week --> Select : Inspect session
Select --> Detail

Detail --> Rationale : Prose alongside sessions
Rationale --> Understand

@enduml