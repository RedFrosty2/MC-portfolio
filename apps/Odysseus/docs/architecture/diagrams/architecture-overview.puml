@startuml
title Odysseus - Architecture Overview

left to right direction
hide empty description

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 18
skinparam ArrowColor #64748B
skinparam ArrowThickness 2
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam defaultFontColor #0F172A
skinparam TitleFontColor #0F172A

skinparam rectangle {
    BorderColor #CBD5E1
    FontColor #0F172A
}

skinparam package {
    BorderColor #94A3B8
    FontColor #334155
}

skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #D6B656
    FontColor #334155
}


rectangle "<b>ATHLETE</b>\n\nUses the Odysseus web application" as Athlete #F8FAFC

package "DRIVING SIDE" #F8FAFC {
    rectangle "<b>WEB ADAPTER</b>\n<i>FastAPI + Jinja</i>\n\nReceives browser interaction\nTranslates web input and output\nInvokes application use cases" as Web #E0F2FE
}

package "ODYSSEUS CORE" #FFFFFF {
    package "APPLICATION LAYER" #F0FDFA {
        rectangle "<b>USE CASES</b>\n\nCoordinate product behaviour\nExample: TrainingAvailabilityUseCases" as UseCases #D1FAE5

        rectangle "<b>OUTBOUND PORTS</b>\n<i>Application contracts</i>\n\nDescribe capabilities required\nfrom outside the core\nExample: TrainingAvailabilityStore" as Ports #CCFBF1
    }

    package "DOMAIN LAYER" #FAF5FF {
        rectangle "<b>DOMAIN MODEL</b>\n\nTraining concepts, values and invariants\nExample: RecurringTrainingAvailability" as Domain #EDE9FE
    }
}

package "DRIVEN SIDE" #FFF7ED {
    rectangle "<b>IN-MEMORY ADAPTERS</b>\n<i>Current</i>\n\nConcrete process-local implementations" as MemoryAdapters #FFEDD5

    rectangle "<b>PERSISTENCE ADAPTERS</b>\n<i>Planned</i>\n\nDurable persistence implementations" as PersistenceAdapters #FFF7ED

    rectangle "<b>PLANNING ADAPTER</b>\n<i>Planned</i>\n\nLocal or self-hosted planning-model boundary" as PlanningAdapter #FFF7ED

    rectangle "<b>INTEGRATION ADAPTERS</b>\n<i>Planned</i>\n\nGarmin, Hevy and Hyresult boundaries" as IntegrationAdapters #FFF7ED
}

package "EXTERNAL RESOURCES" #F8FAFC {
    rectangle "<b>POSTGRESQL</b>\n<i>Planned</i>" as Postgres #F1F5F9
    rectangle "<b>LOCAL PLANNING MODEL</b>\n<i>Planned</i>" as LocalModel #F1F5F9
    rectangle "<b>GARMIN / HEVY / HYRESULT</b>\n<i>Planned</i>" as ExternalSystems #F1F5F9
}

Athlete --> Web : interacts with
Web --> UseCases : drives
UseCases --> Domain : uses
UseCases --> Ports : depends on

MemoryAdapters ..> Ports : implements
PersistenceAdapters ..> Ports : implements
PlanningAdapter ..> Ports : implements
IntegrationAdapters ..> Ports : implements

PersistenceAdapters --> Postgres : reads / writes
PlanningAdapter --> LocalModel : invokes
IntegrationAdapters --> ExternalSystems : integrates with

note bottom of Web
Driving adapters start interaction.
Web concerns remain outside the core.
end note

note bottom of Ports
The application owns its required contracts.
Concrete driven adapters implement them.
end note

note bottom of Domain
The domain owns training meaning and validity.
It has no dependency on HTTP or storage technology.
end note

note bottom of MemoryAdapters
The recurring-availability slice currently uses
an in-memory adapter. Other driven-side areas are
planned architecture and are not yet implemented.
end note

@enduml
